{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Otto",
  "version": "0.17.0",
  "identifier": "dev.jaygupta.otto",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Otto",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 22 },
        "transparent": false,
        "backgroundColor": "#eef0f7",
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "shortDescription": "A calm home for your cloud coding agents",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdEOTZDRjNCOERDMkFGMjgKUldRb3I4S05POCtXZmFibnRCWmxQOVl1M2lsVHpIY2IrQjFNVzlKdzNDRjZDb3pTb292VGt4QnUK",
      "endpoints": ["https://github.com/jaygupta17/otto/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
